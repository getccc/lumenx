# 阿里云 DashScope API Key (用于通义千问等模型)
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# 阿里云 Access Key (用于 OSS、视频超分等服务)
ALIBABA_CLOUD_ACCESS_KEY_ID=your_aliyun_access_key_id_here
ALIBABA_CLOUD_ACCESS_KEY_SECRET=your_aliyun_access_key_secret_here

# OSS 配置 (可选，用于图片/视频存储)
OSS_BUCKET_NAME=your_bucket_name
OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com
OSS_BASE_PATH=comic_gen/

# Kling AI 配置 (可选，用于 Kling 视频生成)
KLING_ACCESS_KEY=your_kling_access_key_here
KLING_SECRET_KEY=your_kling_secret_key_here

# Vidu AI 配置 (可选，用于 Vidu 视频生成)
VIDU_API_KEY=your_vidu_api_key_here

# MuleRun / MuleRouter 配置 (可选，用于 Seedance 2.0 视频生成 + GPT-Image-2 图片生成)
# 方式一 (推荐): 安装 MuleRun CLI 并登录，然后从 mulerun studio config 获取 key
#   npm i -g @mulerunai/cli && mulerun login
#   mulerun studio config  → 复制 API Key (格式: muk-...)
# 方式二: 直接用 MuleRouter API Key
# 两种 key 格式通用，填入同一变量即可：
# MULEROUTER_API_KEY=muk-your-key-here
# 站点选择 (mulerouter=默认, mulerun=更多模型但 gpt-image-2 仅 mulerouter 可用)
# MULEROUTER_SITE=mulerouter

# LLM 多模型适配 (可选)
# 默认使用 DashScope (通过 OpenAI 兼容接口调用，只需上方 DASHSCOPE_API_KEY 即可)
# LLM_PROVIDER=dashscope
#
# 如需切换到第三方 OpenAI 兼容 API (OpenAI/DeepSeek/Ollama 等):
# LLM_PROVIDER=openai
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o
#
# DeepSeek 示例:
# LLM_PROVIDER=openai
# OPENAI_API_KEY=your_deepseek_api_key
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# OPENAI_MODEL=deepseek-chat
#
# 本地 Ollama 示例:
# LLM_PROVIDER=openai
# OPENAI_API_KEY=ollama
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_MODEL=qwen2.5:72b

# API 服务配置
API_HOST=0.0.0.0
API_PORT=8000

# ===============================
# API 端点配置 (可选，海外部署时切换到国际端点)
# 命名约定: {PROVIDER}_BASE_URL
# ===============================
# DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com
# KLING_BASE_URL=https://api.klingai.com/v1
# VIDU_BASE_URL=https://api.vidu.cn/ent/v2
# MULEROUTER_BASE_URL=https://api.mulerouter.ai

# ===============================
# 自托管模型 (ComfyUI / IndexTTS) — 可选
# 全本地部署时使用，与 DashScope 等云端 provider 可并存
# ===============================
# 图像：任意 ComfyUI 实例（参考模板 config/comfyui_workflows/qwen_image_2.1.json）
# COMFYUI_IMAGE_HOST=127.0.0.1:8188
# COMFYUI_IMAGE_WORKFLOW=qwen_image_2.1
#
# 视频：任意 ComfyUI 实例（参考模板 config/comfyui_workflows/minimax_h3_video.json）
# COMFYUI_VIDEO_HOST=127.0.0.1:8188
# COMFYUI_VIDEO_WORKFLOW=minimax_h3_video
#
# 单个任务的超时上限（秒）。H3 在 Apple Silicon 上 5 秒片段约需 6-13 分钟，
# 默认值放得比较宽。
# COMFYUI_TIMEOUT=3600
#
# 覆盖 Host 头。ComfyUI 挂在 `tailscale serve` 后面时必填 —— serve 按主机名
# 路由，直接请求 100.x IP 会拿到纯文本 404，服务其实是好的。
# COMFYUI_HOST_HEADER=my-box.tailXXXX.ts.net
#
# TTS：IndexTTS 2.5（替代 DashScope CosyVoice / Qwen3-TTS）
# INDEXTTS_HOST=127.0.0.1:7860
# INDEXTTS_HOST_HEADER=my-box.tailXXXX.ts.net
# INDEXTTS_LANG=ZH
#
# TTS 引擎选择：dashscope（默认，CosyVoice / Qwen3-TTS）或 indextts
# TTS_PROVIDER=dashscope
